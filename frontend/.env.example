# Frontend (Vite) environment variables
# Only VITE_* values are exposed to the browser. Never put secrets here.

# LOCAL DEVELOPMENT
# Leave unset to use relative `/api` (Vite proxies to http://127.0.0.1:5000).
# VITE_API_BASE_URL=http://localhost:5000/api

# PRODUCTION (Vercel)
# Prefer leaving this UNSET so the browser calls same-origin `/api`,
# which vercel.json rewrites to the Flask backend service.
# Do NOT set this to http://localhost:5000 in Vercel.
# VITE_API_BASE_URL=
