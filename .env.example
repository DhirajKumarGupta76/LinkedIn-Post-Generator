# Shared app configuration
# Copy to `.env` for local development. Set the same keys (without VITE_*)
# in the Vercel project Environment Variables for Production + Preview.

POSTGRES_DB=postgen_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Local default (file SQLite). On Vercel, set a Postgres URL (recommended).
# If SQLite is used on Vercel it is rewritten to /tmp (ephemeral).
DATABASE_URL=sqlite:///postgen_ai.db

SECRET_KEY=replace_me_with_a_secure_random_value_at_least_32_bytes
JWT_SECRET_KEY=replace_me_with_a_secure_random_value_at_least_32_bytes
JWT_REFRESH_SECRET_KEY=replace_me_with_a_secure_random_value_at_least_32_bytes
ENCRYPTION_KEY=replace_me_with_a_valid_base64_fernet_key

AI_API_KEY=replace_me_with_real_key
AI_PROVIDER=openai
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Local CORS. On Vercel, FRONTEND_BASE_URL and VERCEL_* hosts are auto-added.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://linked-in-post-generator-dhiru.vercel.app,https://linked-in-post-generator-git-main-dhiru.vercel.app

MAX_REQUEST_SIZE=1048576
RATELIMIT_DEFAULT=10/minute
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_CHARS=2500
AI_REQUEST_TIMEOUT=20
AI_GENERATION_LIMIT_PER_USER=10

# development for local; production on Vercel (VERCEL=1 also forces production behavior)
FLASK_ENV=development

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LOCAL Google callback (must also be listed in Google Cloud Console)
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:5173

# PRODUCTION values to set in Vercel (do not commit secrets):
# GOOGLE_REDIRECT_URI=https://linked-in-post-generator-dhiru.vercel.app/api/auth/google/callback
# FRONTEND_BASE_URL=https://linked-in-post-generator-dhiru.vercel.app
# COOKIE_SECURE=true
# DATABASE_URL=postgresql://...

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@postgen-ai.local

# Frontend (local / Vercel build): leave unset to use relative `/api`
# VITE_API_BASE_URL=
